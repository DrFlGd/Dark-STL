{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dark STL",
  "mainBinaryName": "Dark STL",
  "identifier": "io.github.drflgd.darkstl",
  "build": {
    "frontendDist": "../src/darkstl/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Dark STL",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#1c2128"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Browse FromSoftware game models, add texture detail and export print-ready meshes",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/engine": "engine"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
